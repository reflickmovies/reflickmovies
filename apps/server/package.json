{
    "name": "@reflick/server",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/index.js",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
        "sync": "tsx src/jobs/syncCatalog.cli.ts",
        "providers:import": "tsx src/jobs/importProviders.cli.ts",
        "verify": "tsx scripts/verifyMongo.ts",
        "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
        "test": "tsx --test scripts/tests/*.test.ts",
        "inspect:embeds": "tsx ../scripts/inspect-embeds.mjs"
    },
    "dependencies": {
        "compression": "^1.7.5",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "express-rate-limit": "^7.5.1",
        "helmet": "^8.0.0",
        "mongoose": "^8.9.5",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@types/compression": "^1.7.5",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/node": "^22.10.5",
        "mongodb-memory-server": "^10.1.3",
        "tsx": "^4.23.15",
        "typescript": "^5.7.2"
    }
}
