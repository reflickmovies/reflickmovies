# ---- Reflick / server ----
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173

# ---- MongoDB (the only datastore; no in-memory fallback) ----
# Local:  docker compose up -d mongo
# Atlas:  mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=reflick
MONGODB_MAX_POOL_SIZE=20
MONGODB_SERVER_SELECTION_TIMEOUT_MS=8000

# ---- TMDB (https://www.themoviedb.org/settings/api) ----
# TMDB is the origin of truth. Nothing here ever reaches the browser.
#
# One key is enough to run, but a pool roughly doubles the rate-limit headroom: TMDB
# budgets ~40-50 requests per 10 seconds PER KEY, and a live homepage spends a lot of
# that on its own. Requests rotate across every token listed here, and a token that
# starts returning 429 is skipped for the rest of that request.
#
# These are v4 read-access tokens (32 hex characters, no dashes). A v3 api_key
# (also 32 hex) still works, but the v4 shape is what you want to rotate.
TMDB_API_KEY=replace_me_with_your_tmdb_v3_key
# Extra tokens, comma-separated. Both are used; neither is preferred.
TMDB_API_KEYS=
TMDB_BASE_URL=https://api.themoviedb.org/3

# ---- Automatic population: nobody has to run a sync by hand ----
# True is the intended setting. On boot the server takes a cheap trending pass so the
# homepage is correct within seconds, fills the long tail in the background if the
# cache is cold, and keeps trending refreshed on a timer from then on.
SYNC_ON_BOOT=true
# TMDB's weekly trending window moves slowly, so 180 minutes is well ahead of it.
SYNC_REFRESH_MINUTES=180
# Full discover walk on a cold deployment. 0 skips it and relies on hydration instead.
SYNC_DISCOVER_PAGES=5
SYNC_TRENDING_PAGES=3
SYNC_GENRES=28,12,16,35,80,878,18,27,53,9648,10749
# Kept low on purpose: higher values trip TMDB's rate limit and accomplish nothing.
SYNC_CONCURRENCY=4
# Resolving logo + textless poster per title costs an extra request each, so it happens
# during the background passes, never on a request path.
SYNC_WITH_ASSETS=true

# ---- Continuing the catalogue while people browse ----
#
# Every catalogue request walks TMDB a little further than it already has, so the catalogue keeps
# growing without anyone running a job. It is the same pipeline as a manual sync - same filters,
# same upserts - just triggered by traffic instead of a timer.
SYNC_GROWTH_ON_READ=true

# ---- The periodic catch-up ----
#
# Growth-on-read only ever moves forward from whatever the last process walked to, so it covers
# popularity. It cannot know about titles TMDB adds to the front of a list - a new season, a newly
# released film that lands in the top of trending - because those are behind a frontier it has
# already passed. This periodic re-sweep of the curated genres is what catches them.
#
# Defaults to a day; lowering it walks TMDB's rate limit closer to its ceiling for no benefit, as
# growth-on-read is already filling in the long tail between sweeps.
SYNC_FULL_SWEEP_MINUTES=1440

# ---- On-demand hydration ----
# A deep link to a title the cache has never seen resolves it live and stores it.
HYDRATE_ON_MISS=true
# Ceiling on visitor-triggered upstream lookups per hour, so a crawler walking slugs
# cannot burn the whole quota. Scheduled refreshes are not charged against this.
HYDRATE_HOURLY_BUDGET=120

# ---- Cache ----
# Short, because TMDB is the source of truth and a stale answer is the wrong answer.
CACHE_TTL_SECONDS=1800
CACHE_MAX_ENTRIES=500
CACHE_STALE_SECONDS=86400

# ---- Upstream resilience ----
TMDB_TIMEOUT_MS=8000
# Raised automatically when more than one token is configured, so a throttled token can
# still be retried on another one.
TMDB_MAX_RETRIES=3

# ---- Rate limits (per window, per client IP) ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_SEARCH_MAX=30
RATE_LIMIT_STREAM_MAX=60

# ---- Logging ----
LOG_LEVEL=info